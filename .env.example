# Copy to .env and change secrets for anything beyond local development.
POSTGRES_PASSWORD=pointwise
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
INTERNAL_API_SECRET=dev-internal-secret-change-me
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-0123456789
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
PGADMIN_EMAIL=admin@pointwise.dev
PGADMIN_PASSWORD=pointwise
# Portfolio features
TOKEN_ENC_KEY=dev-token-encryption-key-change-me-0123456789
BANK_PROVIDER=none
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@pointwise.local
# AI platform (all optional)
AI_ENABLE_MOCK=true
AI_MONTHLY_TOKEN_BUDGET=2000000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# optional self-hosted OpenClaw gateway (OpenAI-compatible); keep it on loopback / a private network
OPENCLAW_BASE_URL=http://host.docker.internal:18789/v1
OPENCLAW_GATEWAY_TOKEN=
MCP_ALLOWED_HOSTS=
# Card data refresh
CARD_SOURCE_ALLOWED_DOMAINS=

# Scheduled refresh of quarterly rotating categories (docs/rotating-categories.md, ADR-029). On by default: the daily job reads the
# issuer's PUBLIC announcement page (no login, robots.txt honoured) only when a quarter is missing. Set to false to turn it off.
ROTATING_AUTO_FETCH=true
# publish issuer-verified offer changes automatically from the scheduled refresh (false = always review)
OFFER_AUTO_PUBLISH=true
# local development only: allow mailbox hosts on private networks (blocked by default to prevent SSRF)
MAILBOX_ALLOW_PRIVATE_HOSTS=false
# Gmail / Outlook sign-in (optional, free): your own app registrations, see docs/email-ingestion-research.md section 7
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
CARD_SOURCE_MIN_INTERVAL_MS=5000

# Backups (docs/backup-restore.md). The nightly backup runs only when BACKUP_PASSPHRASE is set (at least 12 characters).
# Keep the passphrase somewhere safe: without it a backup cannot be read, and it is never stored by the app.
BACKUP_PASSPHRASE=
BACKUP_KEEP=7
BACKUP_INCLUDE_EPHEMERAL=false
