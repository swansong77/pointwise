# PointWise production settings. `bash deploy/install.sh` writes this file for you as .env, with fresh random secrets.
# To do it by hand: copy this file to .env in the project folder, replace every CHANGE_ME, and chmod 600 .env.
# .env is never committed to git. Keep a copy of it somewhere safe (a password manager): the secrets below protect your data.

# ── Address ────────────────────────────────────────────────────────────────────
# The one public address people type in the browser. No trailing slash.
PW_PUBLIC_URL=https://pointwise.example.com
# What Caddy answers on: the host name alone for HTTPS (certificate is automatic), or http://host for a private network.
PW_SITE_ADDRESS=pointwise.example.com
# Ports on the host (change only if 80 or 443 are already in use)
PW_HTTP_PORT=80
PW_HTTPS_PORT=443

# ── Secrets (the installer generates these; each must be long and random) ──────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_characters
INTERNAL_API_SECRET=CHANGE_ME_internal_secret_at_least_32_chars
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret_at_least_32_chars
# Encrypts bank, mailbox and offer logins stored in the database. Losing it makes those unreadable. Keep a copy.
TOKEN_ENC_KEY=CHANGE_ME_token_encryption_key_32_characters_or_more

# ── Backups ────────────────────────────────────────────────────────────────────
# The nightly encrypted backup runs only when this is set (12+ characters). Without it a backup cannot be read: write it down.
BACKUP_PASSPHRASE=CHANGE_ME_backup_passphrase
BACKUP_KEEP=14

# ── Mail (password reset, e-mail digests) ──────────────────────────────────────
# Any SMTP provider works: your mail host, Brevo, Mailgun, Amazon SES, Gmail with an app password.
# Port 587 with STARTTLS is typical; for port 465 also set SMTP_SECURE=true.
MAIL_DISABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="PointWise <pointwise@example.com>"

# ── Optional ───────────────────────────────────────────────────────────────────
# AI models: leave empty to use only the offline demo model. Keys stay on this server. See docs/guides/02-self-host-install.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Container images. Leave unset to build on this server; deploy/deploy.sh --registry sets them to pull prebuilt ones instead.
# PW_BACKEND_IMAGE=ghcr.io/your-name/pointwise-backend:latest
# PW_FRONTEND_IMAGE=ghcr.io/your-name/pointwise-frontend:latest
