# secrets — never commit (only the placeholder template is tracked)
.env
.env.*
!.env.example

# dependencies and build output
node_modules/
.next/
dist/
coverage/
test-results/
cypress/results/
cypress/videos/
cypress/screenshots/
playwright-report/
*.tsbuildinfo

# personal data and local artefacts — never commit
docker/logs/
docker/backups/
*.sql
*.dump
*.sqlite
*.xlsx
*.xls
~$*
*.pdf
*.log
raw/

# OS / editor
.DS_Store
!backend/prisma/migrations/**/*.sql
extension/dist/

# backups and data exports contain personal data: never commit them
*.pwbackup
*.pwbackup.partial
*.pointwise-data.json
*.pointwise-data.json.gz
.env.migrated

# production deployment (deploy/): settings, logs, backups and the deploy lock never go in git
/backups/
/deploy.log
/.deploy.lock
