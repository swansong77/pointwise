# Shell scripts and server config must keep Unix line endings even when checked out on Windows,
# otherwise bash fails with "\r: command not found" (WSL, Docker containers, Caddy).
*.sh text eol=lf
*.example text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.plist text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.env* text eol=lf
