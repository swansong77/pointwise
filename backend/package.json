{
  "name": "pointwise-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pointwise API (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "prisma:sync": "node scripts/sync-schema.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "node dist/seed/seed.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config test/jest-integration.config.js --runInBand",
    "test:live": "jest --config test/jest-live.config.js",
    "eval": "ts-node --transpile-only scripts/run-evals.ts",
    "catalog:import": "node dist/seed/real-catalog.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@google/genai": "3.6.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "imapflow": "^2.12.2",
    "ioredis": "^5.4.2",
    "mailparser": "3.13.0",
    "nodemailer": "^10.6.1",
    "openai": "7.62.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "6.4.299",
    "prisma": "6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
