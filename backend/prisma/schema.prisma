// PointWise — PostgreSQL schema (Prisma)
// Canonical location: project-analysis/database/schema.prisma
// Domain mapping to the analyzed app (see docs/storage.md):
//   DBCard -> CreditCard, DBEarning/DBPointerCard -> Reward, DBPointer -> Category,
//   PointerMerchantEntity -> Merchant, DBInventory -> WalletCard, DBOffer -> Offer,
//   DBOfferInventory -> UserOffer, DBUserProfile -> Profile, DBBank -> Issuer.
// Portfolio revision naming (docs/portfolio-revision-review.md):
//   Cardholder -> Profile (household member), CreditAccount -> WalletCard, CardIssuer -> Issuer,
//   RewardProgram -> RewardCurrency, FiveTwentyFourCalculation -> FiveTwentyFourSnapshot (+ domain/five24.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  recommendations  Recommendation[]
  offerEvents      OfferEvent[]
  plannedPurchases PlannedPurchase[]
  agentRuns        AgentRun[]
  mailboxes        Mailbox[]
  email            String            @unique
  name             String?
  passwordHash     String?
  role             Role              @default(USER)
  emailVerified    DateTime?
  countryCode      String            @default("US")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  accounts             OAuthAccount[]
  refreshTokens        RefreshToken[]
  wallet               Wallet?
  profiles             Profile[]
  memberProfile        Profile?                @relation("ProfileLogin")
  cashbackAccounts UserCashbackAccount[]
  household            Household?
  bankConnections      BankConnection[]
  emailInbox           EmailInbox?
  inboundEmails        InboundEmail[]
  creditReportAccounts CreditReportAccount[]
  importJobs           CardImportJob[]
  retentionReports     RetentionOfferReport[]
  spendProfile         SpendProfileEntry[]
  loyaltyBalances      LoyaltyBalance[]
  pushSubscriptions    PushSubscription[]
  aiSettings           AiSettings?
  aiConversations      AiConversation[]
  searchEntries        SearchEntry[]
  searchSessions       SearchSession[]
  reminders            Reminder[]
  aiDisclosures        AiDisclosure[]
  goals                Goal[]
  copilotMemory        CopilotMemory[]
  copilotBriefings     CopilotBriefing[]
  lifeEvents           LifeEvent[]
  aiUsage              AiUsage[]
  aiPendingActions     AiPendingAction[]
  accessTokens         PersonalAccessToken[]
  subscription         Subscription?
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  transactions         Transaction[]
  analytics            AnalyticsEvent[]
  valuations           UserValuation[]
  categoryPins         CategoryPin[]
  offerAlerts          OfferAlert[]
  offerAccounts        OfferAccount[]
  enrollmentRules      EnrollmentRule[]
  enrollmentPolicy     EnrollmentPolicy?
  enrollmentAttempts   EnrollmentAttempt[]
  offerSyncRuns        OfferSyncRun[]
  auditLogs            AuditLog[]
  passwordResets       PasswordResetToken[]
  statementImports     StatementImport[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyEvents        LoyaltyEvent[]
  loyaltyCertificates  LoyaltyCertificate[]
  eliteStatuses        EliteStatus[]
  memberships          Membership[]
  awardTrips           AwardTrip[]
  loyaltyObservations  LoyaltyObservation[]
  loyaltySyncRuns      LoyaltySyncRun[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String @id @default(uuid())
  userId            String
  provider          String // google | apple
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ───────────────────────────── Household ─────────────────────────────

/// One household per owning user; members are Profiles ("cardholders").
model Household {
  id        String    @id @default(uuid())
  ownerId   String    @unique
  name      String    @default("My household")
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   Profile[]
}

enum CardholderRelationship {
  SELF
  SPOUSE
  PARTNER
  CHILD
  PARENT
  OTHER
}

/// A cardholder in the user's household (the "Cardholder" entity of the portfolio spec).
model Profile {
  id                   String                   @id @default(uuid())
  userId               String
  householdId          String?
  nickname             String
  email                String?
  relationship         CardholderRelationship   @default(OTHER)
  birthYear            Int?
  /// self-reported credit score band (optional input to the next-card scorer; never sent to an AI provider)
  creditBand           CreditBand?
  /// self-reported reward goals (TRAVEL, CASHBACK, HOTEL, AIRLINE, LOW_FEE); used by the recommendation engine, never sent to an AI provider
  goals                String[]                 @default([])
  /// self-reported: can apply for business cards
  hasBusiness          Boolean                  @default(false)
  isPrimary            Boolean                  @default(false)
  sortOrder            Int                      @default(0)
  createdAt            DateTime                 @default(now())
  /// The member's own sign-in, when the owner has given them one (the User row holds only their channels: mailboxes, notifications, briefings)
  loginUserId          String?                  @unique
  /// What the member's own sign-in may see: OWN = this member's cards, benefits, loyalty and spending; HOUSEHOLD = also the household overview (read only)
  visibility           MemberVisibility         @default(OWN)
  loginSince           DateTime?
  /// the owner lets this member add and edit their own cards, points and benefit usage (needs their own sign-in)
  canEdit              Boolean                  @default(false)
  /// false = the owner no longer gets notifications about this member's items; the member does (needs their own sign-in)
  notifyOwner          Boolean                  @default(true)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  household            Household?               @relation(fields: [householdId], references: [id], onDelete: SetNull)
  loginUser            User?                    @relation("ProfileLogin", fields: [loginUserId], references: [id], onDelete: SetNull)
  invites              MemberInvite[]
  cashbackAccounts     UserCashbackAccount[]
  mailboxes            Mailbox[]
  cards                WalletCard[]
  creditReportAccounts CreditReportAccount[]
  five24Snapshots      FiveTwentyFourSnapshot[]
  loyaltyBalances      LoyaltyBalance[]
  offerAccounts        OfferAccount[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyCertificates  LoyaltyCertificate[]
  eliteStatuses        EliteStatus[]
  memberships          Membership[]

  @@index([userId])
  @@index([householdId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Issuer {
  id                        String         @id @default(uuid())
  name                      String         @unique
  countryCode               String         @default("US")
  website                   String?
  /// public page of the issuer's offers; the activation checklist opens it in the user's own browser
  offersUrl                 String?
  offerAccounts             OfferAccount[]
  /// Business cards from this issuer appear on personal credit reports (count toward 5/24).
  businessReportsToPersonal Boolean        @default(false)
  /// Issuer usually denies applicants at 5/24 or above (Phase D scorer).
  enforcesFive24            Boolean        @default(false)
  aliases                   String[] // alternative names used by imports ("Amex", "Chase")
  kind                      IssuerKind     @default(BANK)
  /// last DISCOVER run of the card-research agent for this issuer
  lastResearchedAt          DateTime?
  cards                     CreditCard[]
  offers                    Offer[]
}

enum IssuerKind {
  BANK
  CREDIT_UNION
  CARD_COMPANY // e.g. American Express, Discover
  FINTECH
}

enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
  OTHER
}

enum CardType {
  PERSONAL
  BUSINESS
}

model RewardCurrency {
  id                String                @id @default(uuid())
  code              String                @unique // e.g. CASH, NW_MILES
  name              String
  centsPerPoint     Decimal               @db.Decimal(6, 3) // default valuation (¢ per point)
  isCash            Boolean               @default(false)
  /// points can be combined between members of one household (Phase D award planner)
  householdPooling  Boolean               @default(false)
  /// transfers to partners move in multiples of this many points
  transferIncrement Int                   @default(1000)
  cards             CreditCard[]
  userValuations    UserValuation[]
  transferPartners  TransferPartner[]
  balances          LoyaltyBalance[]
  /// how points expire (general knowledge until verified; users can override per account)
  policyType        ExpirationPolicyType  @default(UNKNOWN)
  policyMonths      Int?
  resetConditions   String[]              @default([])
  policyNote        String?
  policySource      String?
  policyVerified    Boolean               @default(false)
  accounts          LoyaltyAccount[]
  bonusRecords      TransferBonusRecord[]
}

model CreditCard {
  id                     String            @id @default(uuid())
  slug                   String            @unique
  name                   String
  issuerId               String
  network                CardNetwork
  type                   CardType          @default(PERSONAL)
  annualFeeCents         Int               @default(0)
  foreignTxFee           Boolean           @default(false)
  currencyId             String
  color                  String            @default("#334155")
  bonusDescription       String?
  bonusPoints            Int? // welcome bonus in currency units
  bonusSpendCents        Int?
  bonusMonths            Int?
  applyUrl               String?
  countryCode            String            @default("US")
  isActive               Boolean           @default(true)
  /// set for private cards created by a user's import/bank sync — never shown in the public catalog
  ownerId                String?
  // ── master data (Phase C) ──
  description            String?
  productFamily          String? // e.g. "Voyager" — cards that can be product-changed into each other
  productStatus          CardProductStatus @default(OPEN)
  launchDate             DateTime?
  authorizedUserFeeCents Int?
  bonusType              BonusType?
  bonusValuationCents    Int? // estimated value of the current welcome bonus
  offerExpiresAt         DateTime?
  /// credit typically needed for approval (catalog, admin-entered)
  recommendedCredit      CreditBand?
  /// where the catalog entry came from; SEED = curated real-card list awaiting verification
  catalogSource          CatalogSource     @default(ADMIN)
  /// facts as of this date (curated seed) — shown as "unverified, as of …" until a source confirms them
  dataAsOf               DateTime?
  /// last time an issuer page confirmed the card's facts (approved proposal or verified research)
  lastVerifiedAt         DateTime?
  /// what confirmed it: ISSUER_LISTING (issuer's all-cards page: name, type, fee, headline rates) or PRODUCT_PAGE
  verifiedScope          String?
  popularity             Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  issuer           Issuer                 @relation(fields: [issuerId], references: [id])
  currency         RewardCurrency         @relation(fields: [currencyId], references: [id])
  rewards          Reward[]
  features         CardFeature[]
  walletCards      WalletCard[]
  offers           Offer[]
  benefits         Benefit[]
  dataSources      CardDataSource[]
  proposals        CardChangeProposal[]
  researchRuns     CardResearchRun[]
  offerHistory     CardOffer[]
  retentionReports RetentionOfferReport[]

  @@index([issuerId])
  @@index([name])
  @@index([ownerId])
}

model CardFeature {
  id        String     @id @default(uuid())
  cardId    String
  text      String
  sortOrder Int        @default(0)
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Category {
  id           String              @id @default(uuid())
  slug         String              @unique
  name         String
  icon         String              @default("star")
  sortOrder    Int                 @default(0)
  isFallback   Boolean             @default(false) // "Everywhere else"
  parentId     String?
  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]          @relation("CategoryTree")
  merchants    Merchant[]
  rewards      Reward[]
  pins         CategoryPin[]
  spendProfile SpendProfileEntry[]
  transactions Transaction[]
}

model Merchant {
  id            String        @id @default(uuid())
  slug          String        @unique
  name          String
  categoryId    String
  hosts         String[] // web domains, e.g. ["example.com"]
  /// other descriptors this merchant appears under on statements (AMZN MKTPLACE, UBR TECHNOLOGIES…)
  aliases       String[]      @default([])
  /// merchant category codes (ISO 18245)
  mcc           String[]      @default([])
  parentCompany String?
  industry      String?
  logoUrl       String?
  isPopular     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  category      Category      @relation(fields: [categoryId], references: [id])
  locations     Location[]
  rewards       Reward[]
  offers        Offer[]
  pins          CategoryPin[]
  transactions  Transaction[]
  portalRates   PortalRate[]
  benchmark     MerchantBenchmark?

  @@index([categoryId])
  @@index([name])
}

model Location {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  address    String?
  latitude   Float
  longitude  Float
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@index([merchantId])
}

// Earning rule: card earns `multiplier` x in a category or at a merchant.
model Reward {
  id                  String     @id @default(uuid())
  cardId              String
  categoryId          String?
  merchantId          String?
  multiplier          Decimal    @db.Decimal(6, 2)
  description         String
  capCents            Int? // annual/quarterly spend cap
  capPeriod           String? // QUARTER | YEAR
  isRotating          Boolean    @default(false) // must be activated/selected
  startsAt            DateTime?
  endsAt              DateTime?
  /// needs something a category match cannot know (a travel portal, a linked account, an "up to" rate): shown on the card, never used to rank
  conditional         Boolean    @default(false)
  /// when an issuer page last confirmed this rate (null = unverified) and which page
  verifiedAt          DateTime?
  sourceUrl           String?
  /// merchants this category rate does not apply to (superstores and clubs the issuer does not code as supermarkets or grocery stores)
  excludedMerchantIds String[]   @default([])
  card                CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category            Category?  @relation(fields: [categoryId], references: [id])
  merchant            Merchant?  @relation(fields: [merchantId], references: [id])

  @@index([cardId])
  @@index([categoryId])
  @@index([merchantId])
}

// ───────────────────────────── Wallet ─────────────────────────────

model Wallet {
  id        String       @id @default(uuid())
  userId    String       @unique
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     WalletCard[]
}

enum CardStatus {
  APPLIED
  APPROVED
  DENIED
  CLOSED
}

enum Cardholder {
  PRIMARY
  AUTHORIZED_USER
}

enum OpenDatePrecision {
  DAY
  MONTH
}

enum CardSource {
  MANUAL
  SPREADSHEET
  BANK
  CREDIT_REPORT
}

model WalletCard {
  id                     String            @id @default(uuid())
  walletId               String
  cardId                 String
  profileId              String?
  nickname               String?
  notes                  String?
  status                 CardStatus        @default(APPROVED)
  cardholder             Cardholder        @default(PRIMARY)
  /// 4 digits (5 for Amex) — never a full card number
  lastFour               String?           @db.VarChar(5)
  approvedAt             DateTime?
  openDatePrecision      OpenDatePrecision @default(DAY)
  creditLimitCents       Int?
  excludeFrom524         Boolean           @default(false)
  excludeReason          String?
  source                 CardSource        @default(MANUAL)
  sourceRef              String? // provider account id / import row key
  sourceMeta             Json?
  closedAt               DateTime?
  annualFeeOverrideCents Int?
  bonusEarned            Boolean           @default(false)
  bonusSpendCents        Int               @default(0)
  selectedCategoryIds    String[] // chosen rotating/selectable categories
  sortOrder              Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  wallet               Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  card                 CreditCard            @relation(fields: [cardId], references: [id])
  profile              Profile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  userOffers           UserOffer[]
  offerAccountCards    OfferAccountCard[]
  transactions         Transaction[]
  pins                 CategoryPin[]
  benefits             UserBenefit[]
  creditReportAccounts CreditReportAccount[]
  statementImports     StatementImport[]

  @@index([walletId])
  @@index([cardId])
}

model UserValuation {
  id            String         @id @default(uuid())
  userId        String
  currencyId    String
  centsPerPoint Decimal        @db.Decimal(6, 3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency      RewardCurrency @relation(fields: [currencyId], references: [id])

  @@unique([userId, currencyId])
}

model CategoryPin {
  id           String     @id @default(uuid())
  userId       String
  walletCardId String
  categoryId   String?
  merchantId   String?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletCard   WalletCard @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  category     Category?  @relation(fields: [categoryId], references: [id])
  merchant     Merchant?  @relation(fields: [merchantId], references: [id])

  @@unique([userId, categoryId])
  @@unique([userId, merchantId])
}

// ───────────────────────────── Offers ─────────────────────────────

enum OfferKind {
  CASH // $ back
  POINTS // bonus points
  PERCENT // % off up to max
}

model Offer {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  terms              String?
  kind               OfferKind         @default(CASH)
  valueCents         Int               @default(0) // cash value or max discount
  points             Int?
  percent            Decimal?          @db.Decimal(5, 2)
  minSpendCents      Int?
  startsAt           DateTime?
  endsAt             DateTime?
  isRepeatable       Boolean           @default(false)
  maxTimes           Int?
  url                String?
  issuerId           String?
  cardId             String?
  merchantId         String?
  isCustom           Boolean           @default(false)
  createdById        String?
  isActive           Boolean           @default(true)
  /// where the offer came from, and how far to trust it (100 official, 90 account data, 75 email / public page, 50 AI, 25 user)
  source             OfferSource       @default(ADMIN)
  sourceRef          String?
  reliability        Int               @default(75)
  offerType          OfferType         @default(STATEMENT_CREDIT)
  enrollmentRequired Boolean           @default(true)
  verification       OfferVerification @default(UNVERIFIED)
  lastValidatedAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  issuer             Issuer?           @relation(fields: [issuerId], references: [id])
  card               CreditCard?       @relation(fields: [cardId], references: [id])
  merchant           Merchant?         @relation(fields: [merchantId], references: [id])
  userOffers         UserOffer[]
  events             OfferEvent[]

  @@index([merchantId])
  @@index([cardId])
  @@index([endsAt])
}

enum UserOfferStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model UserOffer {
  id                   String              @id @default(uuid())
  walletCardId         String
  offerId              String
  status               UserOfferStatus     @default(ACTIVE)
  amountUsedCents      Int                 @default(0)
  timesUsed            Int                 @default(0)
  isFavorite           Boolean             @default(false)
  snoozedUntil         DateTime?
  redeemedAt           DateTime?
  addedAt              DateTime            @default(now())
  activationStatus     ActivationStatus    @default(PENDING)
  activatedAt          DateTime?
  activationVerifiedBy ActivationVerifier?
  walletCard           WalletCard          @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  offer                Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  events               OfferEvent[]

  @@unique([walletCardId, offerId])
  @@index([status])
}

model OfferAlert {
  id            String   @id @default(uuid())
  userId        String
  keywords      String[]
  minValueCents Int?
  issuerIds     String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Money & engagement ─────────────────────────────

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  walletCardId   String
  merchantId     String?
  categoryId     String?
  /// always positive; the direction is in `kind`
  amountCents    Int
  description    String?
  occurredAt     DateTime          @default(now())
  kind           TransactionKind   @default(PURCHASE)
  source         TransactionSource @default(MANUAL)
  /// bank transaction id, or a hash of date+amount+description for statement imports (dedupe key)
  externalId     String?
  /// the bank's own category label, kept for display / re-mapping
  bankCategory   String?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletCard     WalletCard        @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant       Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  benefitUsages  BenefitUsage[]    @relation("UsageTransaction")
  benefitCredits BenefitUsage[]    @relation("UsageCreditTransaction")

  @@unique([walletCardId, externalId])
  @@index([userId, occurredAt])
}

enum TransactionKind {
  PURCHASE
  CREDIT // statement credit from the issuer (benefit credits post as these)
  REFUND
  PAYMENT
  FEE
}

enum TransactionSource {
  MANUAL
  CSV
  PDF
  BANK
  EMAIL // card transaction alert forwarded to the user's PointWise address
}

/// A user's private forwarding address for card alert emails: <token>@INBOUND_EMAIL_DOMAIN.
model EmailInbox {
  id             String    @id @default(uuid())
  userId         String    @unique
  token          String    @unique
  enabled        Boolean   @default(true)
  received       Int       @default(0)
  lastReceivedAt DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InboundKind {
  ALERT // a transaction alert
  STATEMENT // a statement PDF attachment
  LOYALTY // a loyalty program email or statement (balance, status, certificate, expiry)
  FORWARD_CONFIRMATION // Gmail asks to confirm forwarding
  IGNORED // not a transaction (marketing, payment confirmation, declined …)
}

enum InboundStatus {
  PROCESSED
  NEEDS_CARD // which card? (no or ambiguous last digits) — the user assigns it
  DUPLICATE
  REJECTED // sender not an allow-listed issuer, or failed authentication
}

/// What arrived at the inbox — parsed facts only; the email body is never stored. Kept 90 days.
/// One imported statement file (upload, bulk drop or emailed PDF). Only a SHA-256 of the file and its
/// period are kept — never the file itself — so the same statement is not imported twice and each
/// card shows which months are covered.
model StatementImport {
  id           String               @id @default(uuid())
  userId       String
  walletCardId String
  fileSha256   String               @db.VarChar(64)
  format       String               @db.VarChar(8)
  /// UPLOAD | BULK | EMAIL
  channel      String               @db.VarChar(8)
  periodStart  DateTime?
  periodEnd    DateTime?
  rows         Int                  @default(0)
  imported     Int                  @default(0)
  duplicates   Int                  @default(0)
  createdAt    DateTime             @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletCard   WalletCard           @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  validation   StatementValidation?
  usages       BenefitUsage[]
  detections   BenefitDetection[]

  @@unique([walletCardId, fileSha256])
  @@index([userId, createdAt])
}

/// Completeness check of one imported statement (counts and amounts, found vs imported).
model StatementValidation {
  id                String           @id @default(uuid())
  statementImportId String           @unique
  statementCount    Int
  importedCount     Int
  differenceCount   Int
  statementCents    Int
  importedCents     Int
  missingCents      Int
  /// 0-100
  confidence        Int
  status            ValidationStatus
  details           Json?
  createdAt         DateTime         @default(now())
  statementImport   StatementImport  @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
}

/// One candidate benefit match for a transaction (audit trail, manual overrides, AI reasoning).
model BenefitDetection {
  id                String           @id @default(uuid())
  userBenefitId     String
  transactionId     String
  usageId           String?
  statementImportId String?
  method            String           @db.VarChar(8)
  confidence        Int
  rule              String           @db.VarChar(120)
  merchant          String           @db.VarChar(120)
  /// ASSIGN | REVIEW
  tier              String           @db.VarChar(8)
  status            DetectionStatus  @default(DETECTED)
  /// AI classifier's stated reasoning (stored for audit); null for rule-based matches
  aiReasoning       String?
  duplicateRisk     Boolean          @default(false)
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())
  userBenefit       UserBenefit      @relation(fields: [userBenefitId], references: [id], onDelete: Cascade)
  statementImport   StatementImport? @relation(fields: [statementImportId], references: [id], onDelete: SetNull)

  @@unique([userBenefitId, transactionId])
  @@index([transactionId])
}

model InboundEmail {
  id               String        @id @default(uuid())
  userId           String
  receivedAt       DateTime      @default(now())
  fromDomain       String
  subject          String
  kind             InboundKind
  status           InboundStatus
  verified         Boolean       @default(false)
  lastDigits       String?       @db.VarChar(5)
  amountCents      Int?
  merchant         String?
  occurredAt       DateTime?
  credit           Boolean       @default(false)
  walletCardId     String?
  transactionId    String?
  note             String?
  confirmationCode String?
  confirmationUrl  String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
}

enum UsageSource {
  MANUAL
  AUTO_PURCHASE // a matching purchase — credit expected
  AUTO_CREDIT // the issuer's statement credit posted
}

enum UsageVerification {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum DetectionStatus {
  DETECTED
  ACCEPTED
  REJECTED
}

enum ValidationStatus {
  PASS
  WARNING
  FAILED
}

enum UsageStatus {
  CONFIRMED
  EXPECTED // purchase matched; waiting for the statement credit
  DISMISSED // user said "not this benefit" — kept so the transaction is never matched again
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  interval           String? // month | year | lifetime
  provider           String             @default("mock")
  providerCustomerId String?
  providerSubId      String?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  LOYALTY_STALE
  LOYALTY_EXPIRING
  BENEFIT_EXPIRING
  OFFER_EXPIRING
  CARD_RENEWAL
  BONUS_DEADLINE
  OFFER_ALERT
  TRANSFER_BONUS
  SYSTEM
  OFFER_NEW_HIGH_VALUE
  OFFER_AUTO_ENROLLED
  OFFER_ENROLL_FAILED
  OFFER_SYNC_FAILED
  OFFER_SAVINGS_DIGEST
  BACKUP_FAILED
  REMINDER
  COPILOT
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  link       String?
  dedupeKey  String?
  readAt     DateTime?
  emailedAt  DateTime?
  /// held for the executive briefing (quiet mode); not shown as unread and not e-mailed
  deferredAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, deferredAt])
}

model NotificationPreference {
  userId          String  @id
  offerExpiring   Boolean @default(true)
  cardRenewal     Boolean @default(true)
  bonusDeadline   Boolean @default(true)
  offerAlerts     Boolean @default(true)
  emailDigest     Boolean @default(true)
  expiringDays    Int     @default(7)
  benefitExpiring Boolean @default(true)
  benefitEmail    Boolean @default(true)
  benefitPush     Boolean @default(false)
  transferBonuses Boolean @default(true)
  offerAutomation Boolean @default(true)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyExpiring Boolean @default(true)
  loyaltyStale    Boolean @default(true)
  /// hold non-critical notifications for the executive briefing instead of sending each one
  quietMode       Boolean @default(false)
  /// a household member's own briefing: what is due for them (daily, only when there is something) and a weekly summary
  briefingDaily   Boolean @default(true)
  briefingWeekly  Boolean @default(true)
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  properties Json     @default("{}")
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
}

// ───────────────────────────── Benefits ─────────────────────────────

model BenefitCategory {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  sortOrder    Int           @default(0)
  benefits     Benefit[]
  userBenefits UserBenefit[]
}

enum BenefitPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  MULTI_YEAR
  ONE_TIME
  CUSTOM
}

enum PeriodBasis {
  CALENDAR
  CARDMEMBER_YEAR
}

enum BenefitKind {
  CREDIT
  CERTIFICATE
  MEMBERSHIP
  ACCESS
}

/// Catalog template: a benefit that comes with a card product.
model Benefit {
  id                   String           @id @default(uuid())
  cardId               String
  categoryId           String?
  name                 String
  kind                 BenefitKind      @default(CREDIT)
  period               BenefitPeriod    @default(ANNUAL)
  periodMonths         Int              @default(12) // 1/3/6/12, or e.g. 48 for MULTI_YEAR
  basis                PeriodBasis      @default(CALENDAR)
  amountPerPeriodCents Int              @default(0)
  howIssued            String?
  actionNeeded         String?
  notes                String?
  isActive             Boolean          @default(true)
  /// matching rules copied to tracked benefits; null = suggested from name / category
  autoRules            Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  card                 CreditCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category             BenefitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userBenefits         UserBenefit[]

  @@unique([cardId, name])
}

/// A benefit tracked on one of the user's cards (copied from a template or custom).
model UserBenefit {
  id                   String                @id @default(uuid())
  walletCardId         String
  benefitId            String?
  categoryId           String?
  name                 String
  kind                 BenefitKind           @default(CREDIT)
  period               BenefitPeriod         @default(ANNUAL)
  periodMonths         Int                   @default(12)
  basis                PeriodBasis           @default(CALENDAR)
  amountPerPeriodCents Int
  howIssued            String?
  actionNeeded         String?
  notes                String?
  enabled              Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  walletCard           WalletCard            @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  benefit              Benefit?              @relation(fields: [benefitId], references: [id], onDelete: SetNull)
  category             BenefitCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  usages               BenefitUsage[]
  notifications        BenefitNotification[]
  /// automatic tracking from transactions (on by default)
  autoTrack            Boolean               @default(true)
  /// {keywords, categories, creditKeywords}; null = rules suggested from name / category
  autoRules            Json?
  /// the benefit stops being usable on this date (certificates, one-time offers)
  expiresOn            DateTime?
  /// ONE_TIME: the single usable window
  windowStart          DateTime?
  windowEnd            DateTime?
  detections           BenefitDetection[]

  @@unique([walletCardId, name])
  @@index([walletCardId])
}

/// Money (or a certificate) used within one period instance of a benefit.
model BenefitUsage {
  id                  String            @id @default(uuid())
  userBenefitId       String
  periodStart         DateTime
  amountCents         Int
  usedOn              DateTime          @default(now())
  note                String?
  source              UsageSource       @default(MANUAL)
  status              UsageStatus       @default(CONFIRMED)
  /// purchase (or credit) that created this usage; deleting it removes the usage
  transactionId       String?
  /// statement credit that confirmed an EXPECTED usage
  creditTransactionId String?
  /// how the usage was found: MANUAL | EXACT | ALIAS | REGEX | FUZZY | AI
  detectionMethod     String?           @db.VarChar(8)
  /// 0-100
  confidence          Int?
  verification        UsageVerification @default(UNVERIFIED)
  /// the statement import that supplied the evidence
  statementImportId   String?
  /// {merchant, rule, line}
  evidence            Json?
  createdAt           DateTime          @default(now())
  statementImport     StatementImport?  @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  userBenefit         UserBenefit       @relation(fields: [userBenefitId], references: [id], onDelete: Cascade)
  transaction         Transaction?      @relation("UsageTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  creditTransaction   Transaction?      @relation("UsageCreditTransaction", fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@unique([userBenefitId, transactionId])
  @@index([creditTransactionId])
  @@index([userBenefitId, periodStart])
  @@index([statementImportId])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// Delivery log: one row per (benefit, period, threshold, channel) — makes alerts idempotent.
model BenefitNotification {
  id            String              @id @default(uuid())
  userBenefitId String
  periodEnd     DateTime
  thresholdDays Int
  channel       NotificationChannel
  success       Boolean             @default(true)
  sentAt        DateTime            @default(now())
  userBenefit   UserBenefit         @relation(fields: [userBenefitId], references: [id], onDelete: Cascade)

  @@unique([userBenefitId, periodEnd, thresholdDays, channel])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Imports & connections ─────────────────────────────

enum ImportSource {
  SPREADSHEET
  CSV
  BANK
  CREDIT_REPORT
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  FAILED
  DISCARDED
}

enum ImportRowResult {
  NEW
  UPDATE
  DUPLICATE
  SKIPPED
  ERROR
}

model CardImportJob {
  id          String       @id @default(uuid())
  userId      String
  source      ImportSource
  status      ImportStatus @default(PREVIEW)
  fileName    String?
  summary     Json         @default("{}")
  errors      Json         @default("[]")
  createdAt   DateTime     @default(now())
  committedAt DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows        ImportRow[]

  @@index([userId, createdAt])
}

model ImportRow {
  id        String          @id @default(uuid())
  jobId     String
  kind      String // CARD | BENEFIT
  rowNumber Int
  data      Json
  result    ImportRowResult
  message   String?
  matchedId String? // existing wallet card id (UPDATE/DUPLICATE) or catalog card id
  job       CardImportJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

enum BankProvider {
  PLAID
}

model BankConnection {
  id              String       @id @default(uuid())
  userId          String
  provider        BankProvider
  institutionName String?
  itemId          String
  accessTokenEnc  String // AES-256-GCM, key from TOKEN_ENC_KEY
  lastSyncedAt    DateTime?
  /// transactions sync cursor (Plaid /transactions/sync)
  txCursor        String?
  /// the bank needs the user to sign in again (Plaid ITEM_LOGIN_REQUIRED / PENDING_EXPIRATION)
  needsReauth     Boolean      @default(false)
  lastError       String?
  lastTxSyncAt    DateTime?
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, itemId])
  @@index([userId])
}

enum Bureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
  OTHER
}

/// A tradeline transcribed from a credit report (manual entry or CSV), matched to a wallet card.
model CreditReportAccount {
  id               String            @id @default(uuid())
  userId           String
  profileId        String?
  bureau           Bureau            @default(OTHER)
  creditorName     String
  lastDigits       String?           @db.VarChar(5)
  openedOn         DateTime
  isBusiness       Boolean           @default(false)
  isAuthorizedUser Boolean           @default(false)
  status           String            @default("OPEN") // OPEN | CLOSED
  creditLimitCents Int?
  /// DAY when the report shows the full date (Credit Karma usually does), else MONTH
  openedPrecision  OpenDatePrecision @default(MONTH)
  closedOn         DateTime?
  accountType      String?
  /// MANUAL | CREDIT_KARMA_PDF | CREDIT_KARMA_TEXT | BUREAU_PDF | BUREAU_TEXT | MULTIPLE
  source           String            @default("MANUAL")
  /// bureaus whose reports listed this account (merged import)
  reportedBy       Bureau[]
  walletCardId     String?
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          Profile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  walletCard       WalletCard?       @relation(fields: [walletCardId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Daily per-cardholder history of the 5/24 count (charting / audit).
model FiveTwentyFourSnapshot {
  id        String   @id @default(uuid())
  profileId String
  takenOn   DateTime @db.Date
  count     Int
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, takenOn])
}

// ───────────────────────────── AI platform ─────────────────────────────

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  AZURE_OPENAI
  GEMINI
  OPENAI_COMPATIBLE // xAI Grok, Mistral, DeepSeek, OpenRouter, …
  OLLAMA
  MOCK // deterministic provider for tests / demos without keys
}

enum AiStatus {
  ACTIVE
  DISABLED
}

/// An LLM provider account. API keys are AES-256-GCM encrypted and never returned by the API.
model AiProvider {
  id         String         @id @default(uuid())
  name       String         @unique
  kind       AiProviderKind
  baseUrl    String?
  apiVersion String?
  apiKeyEnc  String?
  /// read the key from this environment variable instead of the database (e.g. ANTHROPIC_API_KEY)
  apiKeyEnv  String?
  status     AiStatus       @default(DISABLED)
  settings   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  models     AiModel[]
}

model AiModel {
  id              String     @id @default(uuid())
  providerId      String
  modelId         String // the provider's model identifier, e.g. claude-opus-5-5
  displayName     String
  contextWindow   Int?
  maxOutputTokens Int?
  /// USD per 1M tokens
  inputPrice      Decimal?   @db.Decimal(10, 4)
  outputPrice     Decimal?   @db.Decimal(10, 4)
  cacheReadPrice  Decimal?   @db.Decimal(10, 4)
  capabilities    String[] // tools, vision, thinking, streaming, caching
  rateLimitRpm    Int?
  status          AiStatus   @default(ACTIVE)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  provider        AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usage           AiUsage[]

  @@unique([providerId, modelId])
}

/// One of the specialised assistants: prompt + allowed tools + ordered model chain (failover).
model AgentProfile {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String
  systemPrompt String
  tools        String[] // PointWise tool names
  mcpToolIds   String[] // approved external MCP tools
  modelChain   String[] // AiModel ids, in failover order
  effort       String? // low | medium | high (providers that support it)
  maxSteps     Int      @default(6)
  maxTokens    Int      @default(4096)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model AiSettings {
  userId              String    @id
  consentedAt         DateTime? // required before any data is sent to an AI provider
  preferredModelId    String?
  monthlyTokenBudget  Int? // overrides AI_MONTHLY_TOKEN_BUDGET
  /// opt-in: let the user's chosen model classify cleaned merchant names (never amounts, dates, digits or names) for benefit detection
  classifyMerchants   Boolean   @default(false)
  /// AI Mode (Copilot) is on: the command bar and the Copilot page answer with a plan
  aiModeEnabled       Boolean   @default(false)
  /// QUICK | PLANNING | RESEARCH | TRAVEL | CARD_STRATEGY | AUDIT
  copilotMode         String    @default("QUICK")
  /// 0..1; applied to models that accept it
  temperature         Float?
  /// LOW | MEDIUM | HIGH
  reasoningDepth      String?
  /// CONCISE | BALANCED | DETAILED
  responseStyle       String    @default("BALANCED")
  /// separate, off-by-default consent to share a redacted, pseudonymized view with cloud models (ADR-004a)
  cloudShareConsentAt DateTime?
  /// names of the AI providers allowed to receive that view; local providers are always allowed
  cloudProviders      String[]  @default([])
  /// AI Mode briefings and alerts, for members who have AI Mode on
  briefingDaily       Boolean   @default(true)
  briefingWeekly      Boolean   @default(true)
  briefingMonthly     Boolean   @default(true)
  copilotAlerts       Boolean   @default(true)
  /// Chief of Staff: executive briefing, monthly board report and critical alerts
  chiefOfStaff        Boolean   @default(false)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  agentKey  String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

enum AiRole {
  USER
  ASSISTANT
}

/// Normalised transcript entry (provider-neutral); `content` holds text, tool calls and tool results.
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AiRole
  content        Json
  modelId        String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiUsage {
  id               String         @id @default(uuid())
  userId           String?
  conversationId   String?
  agentKey         String
  modelId          String?
  providerKind     AiProviderKind
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  cacheReadTokens  Int            @default(0)
  cacheWriteTokens Int            @default(0)
  costMicroUsd     Int? // null when the model has no price row
  latencyMs        Int            @default(0)
  success          Boolean        @default(true)
  errorCode        String?
  createdAt        DateTime       @default(now())
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  model            AiModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  FAILED
}

/// A write action proposed by the assistant; it runs only after the user confirms it.
model AiPendingAction {
  id             String              @id @default(uuid())
  userId         String
  conversationId String?
  tool           String
  input          Json
  summary        String
  status         PendingActionStatus @default(PENDING)
  result         Json?
  createdAt      DateTime            @default(now())
  decidedAt      DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Personal access tokens (for the PointWise MCP server). Only a SHA-256 hash is stored.
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  prefix     String // first characters, for display
  tokenHash  String    @unique
  scopes     String[] // e.g. mcp:read
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── MCP client registry (admin only) ─────────────────────────────

enum McpAuthType {
  NONE
  BEARER
}

enum McpHealth {
  UNKNOWN
  UP
  DOWN
}

model McpServer {
  id            String      @id @default(uuid())
  name          String      @unique
  url           String
  authType      McpAuthType @default(NONE)
  authSecretEnc String?
  status        AiStatus    @default(DISABLED)
  version       String?
  health        McpHealth   @default(UNKNOWN)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tools         McpTool[]
}

/// A tool discovered on a remote MCP server. Usable only when enabled AND the approved description
/// hash still matches the current one (tool definitions that change must be re-approved).
model McpTool {
  id              String    @id @default(uuid())
  serverId        String
  name            String
  description     String
  inputSchema     Json
  descriptionHash String
  approvedHash    String?
  enabled         Boolean   @default(false)
  readOnly        Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
}

// ───────────────────────────── Card knowledge base (Phase C) ─────────────────────────────

enum CardProductStatus {
  OPEN // accepting applications
  CLOSED_TO_NEW // existing cardholders only
  DISCONTINUED
}

enum BonusType {
  POINTS
  MILES
  CASH
  NIGHTS
  OTHER
}

enum CardSourceKind {
  ISSUER_PAGE
  MANUAL
}

/// A public page (issuer product page) the refresh engine reads for one catalog card.
model CardDataSource {
  id            String               @id @default(uuid())
  cardId        String
  url           String
  kind          CardSourceKind       @default(ISSUER_PAGE)
  active        Boolean              @default(true)
  etag          String?
  lastModified  String?
  contentHash   String?
  lastFetchedAt DateTime?
  lastStatus    String? // UNCHANGED | PROPOSED | NO_CHANGE | ERROR | BLOCKED
  lastError     String?
  failureCount  Int                  @default(0)
  createdAt     DateTime             @default(now())
  card          CreditCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  proposals     CardChangeProposal[]

  @@unique([cardId, url])
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

/// One field change found by the refresh engine; applied only when an admin approves it.
model CardChangeProposal {
  id         String          @id @default(uuid())
  cardId     String
  sourceId   String?
  field      String
  oldValue   Json?
  newValue   Json
  evidence   String // quoted text from the page that supports the value
  confidence Float
  method     String // LLM | HEURISTIC | MANUAL
  status     ProposalStatus  @default(PENDING)
  reviewerId String?
  decidedAt  DateTime?
  createdAt  DateTime        @default(now())
  card       CreditCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source     CardDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([cardId])
}

enum OfferVersionKind {
  WELCOME
  ELEVATED
  LIMITED_TIME
}

/// Versioned offer history (SCD type 2): exactly one open version (validTo NULL) per card and kind.
model CardOffer {
  id             String           @id @default(uuid())
  cardId         String
  kind           OfferVersionKind @default(WELCOME)
  bonusType      BonusType?
  bonusAmount    Int?
  minSpendCents  Int?
  spendMonths    Int?
  annualFeeCents Int
  valuationCents Int?
  description    String?
  elevated       Boolean          @default(false)
  validFrom      DateTime
  validTo        DateTime?
  source         String // proposal id, "seed" or "admin"
  changeNote     String?
  card           CreditCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, kind, validFrom])
}

/// Retention offers reported by users (shown aggregated, never with the reporter).
model RetentionOfferReport {
  id         String     @id @default(uuid())
  userId     String
  cardId     String
  reportedOn DateTime   @default(now())
  offer      String
  accepted   Boolean
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, reportedOn])
}

// ───────────────────────────── Phase D: recommendations & travel ─────────────────────────────

/// The household's typical monthly spend per category (input to the next-card scorer).
model SpendProfileEntry {
  id           String   @id @default(uuid())
  userId       String
  categoryId   String
  monthlyCents Int
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

/// Self-reported credit score bands (FICO-style ranges: excellent 800+, very good 740–799, good 670–739, fair 580–669, poor < 580).
enum CreditBand {
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum LoyaltyKind {
  AIRLINE
  HOTEL
  OTHER
  SHOPPING
  DINING
  CRUISE
  RENTAL_CAR
  CASINO
  RETAIL
}

/// Airline / hotel loyalty program (catalog, admin-curated).
model LoyaltyProgram {
  id               String                @id @default(uuid())
  code             String                @unique
  name             String
  kind             LoyaltyKind           @default(AIRLINE)
  centsPerPoint    Decimal               @db.Decimal(6, 3)
  householdPooling Boolean               @default(false)
  isActive         Boolean               @default(true)
  partners         TransferPartner[]
  balances         LoyaltyBalance[]
  /// how points expire (general knowledge until verified; users can override per account)
  policyType       ExpirationPolicyType  @default(UNKNOWN)
  policyMonths     Int?
  resetConditions  String[]              @default([])
  policyNote       String?
  policySource     String?
  policyVerified   Boolean               @default(false)
  transferable     Boolean               @default(false)
  accounts         LoyaltyAccount[]
  certificates     LoyaltyCertificate[]
  statuses         EliteStatus[]
  bonusRecords     TransferBonusRecord[]
}

/// Bank currency → loyalty program transfer (ratio, timing, current bonus).
model TransferPartner {
  id           String         @id @default(uuid())
  currencyId   String
  programId    String
  ratioFrom    Int            @default(1)
  ratioTo      Int            @default(1)
  transferDays Int            @default(0)
  bonusPercent Int            @default(0)
  bonusEndsAt  DateTime?
  notes        String?
  updatedAt    DateTime       @updatedAt
  currency     RewardCurrency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  program      LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([currencyId, programId])
}

/// A member's balance in a bank currency or a loyalty program (manually entered).
model LoyaltyBalance {
  id         String          @id @default(uuid())
  userId     String
  profileId  String
  currencyId String?
  programId  String?
  points     Int
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile    Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  currency   RewardCurrency? @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  program    LoyaltyProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
}

enum CatalogSource {
  DEMO // fictional demo/test catalog
  SEED // curated real-card list (unverified until a source confirms it)
  ADMIN // entered by an admin
  RESEARCH // created from an approved card-research candidate
}

enum CardResearchKind {
  DISCOVER // find an issuer's current cards
  VERIFY // find the official page of one catalog card and re-check its facts
  NEWS // scan card news / community sites for new cards and offers, confirmed on issuer pages
}

enum CardResearchStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum CardCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One run of the card-research agent (Claude + web search limited to issuer domains). Admin-only.
model CardResearchRun {
  id            String             @id @default(uuid())
  kind          CardResearchKind
  issuer        String?
  cardId        String?
  focus         String?
  /// DISCOVER: at most this many cards
  maxCards      Int                @default(10)
  /// let the agent read card news / community sites (leads only; facts still come from issuer pages)
  useLeads      Boolean            @default(true)
  status        CardResearchStatus @default(QUEUED)
  model         String?
  searches      Int                @default(0)
  fetches       Int                @default(0)
  inputTokens   Int                @default(0)
  outputTokens  Int                @default(0)
  candidates    Int                @default(0)
  sources       Json? // [{url,title}] pages the agent searched/fetched
  notes         String?
  error         String?
  requestedById String?
  createdAt     DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  card          CreditCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  results       CardCandidate[]

  @@index([status, createdAt])
}

/// A card found by a research run, with evidence-checked facts. Nothing reaches the catalog until an admin approves it.
model CardCandidate {
  id             String              @id @default(uuid())
  runId          String
  issuerName     String
  name           String
  network        CardNetwork?
  type           CardType            @default(PERSONAL)
  annualFeeCents Int?
  productUrl     String
  data           Json // validated facts (rewards, bonus, features …) each with its evidence
  verification   String // VERIFIED | PARTIAL | UNVERIFIED
  evidenceFrom   String // POINTWISE (our fetch) | AGENT (page fetched by the agent) | NONE
  verifiedFacts  Int                 @default(0)
  totalFacts     Int                 @default(0)
  matchedCardId  String?
  status         CardCandidateStatus @default(PENDING)
  createdCardId  String?
  reviewerId     String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime            @default(now())
  run            CardResearchRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([runId])
}

// ───────────── recommendation audit, agent runs, prompts, mailboxes ─────────────

/// One stored recommendation: the inputs snapshot (no card numbers) and every factor's contribution.
model Recommendation {
  id                  String                 @id @default(uuid())
  userId              String
  profileId           String?
  cardId              String
  engineVersion       String
  /// counts / flags the engine used (goals, recent applications, balances by currency, utilization %)
  inputs              Json
  /// the versioned weights in force
  weights             Json
  scoreCents          Int
  firstYearValueCents Int
  longTermValueCents  Int
  /// 0-1, an estimate banded from the self-reported credit band and issuer rules
  probability         Float
  confidence          Float
  eligible            Boolean
  risks               Json
  advice              Json
  createdAt           DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  factors             RecommendationFactor[]

  @@index([userId, createdAt])
}

model RecommendationFactor {
  id               String         @id @default(uuid())
  recommendationId String
  key              String
  label            String
  deltaCents       Int
  note             String?
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One orchestrated workflow execution (auditable reasoning).
model AgentRun {
  id             String      @id @default(uuid())
  userId         String
  workflow       String
  question       String?
  status         RunStatus   @default(RUNNING)
  engineVersion  String
  /// prompt template versions used by narration steps, by key
  promptVersions Json?
  result         Json?
  error          String?
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps          AgentStep[]

  @@index([userId, startedAt])
}

model AgentStep {
  id            String   @id @default(uuid())
  runId         String
  ordinal       Int
  agentKey      String
  engine        String
  /// PUBLIC (catalog data) or USER (the user's own data; never sent to a non-local model)
  privacy       String   @db.VarChar(8)
  /// OK | SKIPPED | FAILED
  status        String   @db.VarChar(8)
  inputHash     String   @db.VarChar(64)
  output        Json?
  /// model that narrated this step (local only for USER steps), if any
  narratedBy    String?
  promptKey     String?
  promptVersion Int?
  durationMs    Int      @default(0)
  error         String?
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, ordinal])
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Versioned prompt text. Exactly one PUBLISHED version per key is in force.
model PromptTemplate {
  id        String       @id @default(uuid())
  key       String
  version   Int
  body      String
  status    PromptStatus @default(DRAFT)
  note      String?
  createdBy String?
  createdAt DateTime     @default(now())

  @@unique([key, version])
  @@index([key, status])
}

enum MailboxKind {
  IMAP
  GMAIL
  GRAPH
}

/// A connected mailbox (read-only). The secret is encrypted with TOKEN_ENC_KEY; bodies are never stored.
model Mailbox {
  id         String      @id @default(uuid())
  userId     String
  kind       MailboxKind @default(IMAP)
  label      String
  host       String?
  port       Int?
  username   String
  secretEnc  String
  folder     String      @default("INBOX")
  /// IMAP UIDVALIDITY:UID or provider delta token
  cursor     String?
  active     Boolean     @default(true)
  lastSyncAt DateTime?
  lastStatus String?
  lastError  String?
  processed  Int         @default(0)
  createdAt  DateTime    @default(now())
  /// Which household member's data this mailbox feeds. Null = the whole household of the owner. A member's own mailbox always feeds that member.
  profileId  String?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile    Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([userId, kind, username])
  @@index([active, lastSyncAt])
  @@index([profileId])
}

// ───────────── merchant offer intelligence ─────────────

enum OfferSource {
  ISSUER_OFFICIAL
  ACCOUNT_DATA
  EMAIL
  PUBLIC_PAGE
  AI_INFERRED
  USER_ENTERED
  ADMIN
  PORTAL
  EXTENSION
  CONNECTOR
}

enum OfferType {
  STATEMENT_CREDIT
  CASHBACK_PERCENT
  POINTS_BONUS
  SPEND_GET
  PORTAL_RATE
  COUPON
}

enum OfferVerification {
  UNVERIFIED
  VERIFIED
  DISPUTED
}

enum ActivationStatus {
  NOT_REQUIRED
  PENDING
  ACTIVATED
  FAILED
}

enum ActivationVerifier {
  MANUAL
  STATEMENT
  EMAIL
  CONNECTOR
  EXTENSION
}

enum OfferEventType {
  IMPORTED
  UPDATED
  ACTIVATED
  ACTIVATION_FAILED
  ACTIVATION_VERIFIED
  EXPIRED
  REDEEMED
  RECOMMENDED
  MISSED_DETECTED
  PLANNED
  DISCOVERED
  REMOVED
  DECISION
  ENROLL_ATTEMPT
  AUTO_ENROLLED
  SYNC
  RULE_CHANGED
}

/// Traceable history of everything that happens to an offer for a user (import, activation, recommendation…).
model OfferEvent {
  id          String         @id @default(uuid())
  userId      String
  offerId     String?
  userOfferId String?
  type        OfferEventType
  /// USER | SYSTEM | AGENT
  actor       String         @db.VarChar(8)
  /// evidence, confidence, weights, reasoning (no card numbers)
  detail      Json
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer       Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  userOffer   UserOffer?     @relation(fields: [userOfferId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([offerId])
}

/// Shopping-portal cash-back / points rate for a merchant, entered by hand (portals are not scraped).
model PortalRate {
  id              String    @id @default(uuid())
  portal          String
  merchantId      String
  ratePercent     Decimal?  @db.Decimal(5, 2)
  pointsPerDollar Decimal?  @db.Decimal(6, 2)
  source          String
  expiresAt       DateTime?
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
  /// when the rate was last seen or confirmed (a rate that nobody has looked at for weeks is shown as stale)
  observedAt      DateTime  @default(now())
  /// MANUAL, CSV, PASTE or AUTO (read from the site's public page)
  method          String    @default("MANUAL")
  /// "up to" rates are the best case: they are counted at a haircut
  upTo            Boolean   @default(false)
  /// a condition the site states (new members only, selected categories, ...)
  conditions      String?
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([portal, merchantId])
  @@index([merchantId])
}

enum PlannedPurchaseStatus {
  PLANNED
  DONE
  CANCELLED
}

model PlannedPurchase {
  id                 String                @id @default(uuid())
  userId             String
  merchantId         String?
  merchantText       String
  amountCents        Int
  plannedFor         DateTime?
  /// the latest plan: ranked options with evidence and confidence, plus insights (expiry impact, best time, best member)
  result             Json?
  /// what is being bought ("MacBook Pro"), its spend category slug and how much it matters
  item               String?
  category           String?
  priority           String?
  status             PlannedPurchaseStatus @default(PLANNED)
  /// the card the user paid with and what it returned, once bought: expected vs actual savings
  chosenWalletCardId String?
  expectedCents      Int?
  actualCents        Int?
  createdAt          DateTime              @default(now())
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, plannedFor])
  @@index([userId, status])
}

// ───────────── loyalty asset management ─────────────

enum ExpirationPolicyType {
  NEVER // no expiration
  ACTIVITY // expires after N months with no qualifying activity
  FIXED // each point expires N months after it was earned
  WHILE_CARD_OPEN // kept while the earning card account is open
  UNKNOWN
}

enum LoyaltySource {
  MANUAL
  IMPORT
  EMAIL
}

enum LoyaltyEventKind {
  SNAPSHOT
  EARN
  BONUS
  PURCHASE
  REDEEM
  EXPIRE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
}

enum CertificateCategory {
  FREE_NIGHT
  COMPANION
  UPGRADE
}

enum CertificateStatus {
  AVAILABLE
  USED
  EXPIRED
  CANCELLED
}

enum StatusKind {
  AIRLINE
  HOTEL
  RENTAL_CAR
  CRUISE
  CARD
}

enum MembershipKind {
  CLEAR
  TSA_PRECHECK
  GLOBAL_ENTRY
  PRIORITY_PASS
  DRAGONPASS
  AIRLINE_CLUB
  HOTEL
  OTHER
}

/// One loyalty account of a household member: an airline / hotel / other program, or a bank rewards currency.
model LoyaltyAccount {
  id                      String               @id @default(uuid())
  userId                  String
  profileId               String
  programId               String?
  currencyId              String?
  /// a program that is not in the registry ("future programs")
  customName              String?
  customKind              LoyaltyKind?
  customCentsPerPoint     Decimal?             @db.Decimal(6, 3)
  nickname                String?
  /// encrypted; only the last digits are ever shown
  accountNumberEnc        String?
  accountLast4            String?              @db.VarChar(8)
  memberSince             DateTime?
  balance                 Int                  @default(0)
  pendingBalance          Int                  @default(0)
  lifetimePoints          Int                  @default(0)
  statusLevel             String?
  statusDeadline          DateTime?
  /// expiry date the member knows from the program, overriding the predicted one
  expiresAt               DateTime?
  lastActivityAt          DateTime?
  source                  LoyaltySource        @default(MANUAL)
  refreshedAt             DateTime             @default(now())
  /// overrides the program's transferability
  transferable            Boolean?
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile                 Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  program                 LoyaltyProgram?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  currency                RewardCurrency?      @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  events                  LoyaltyEvent[]
  certificates            LoyaltyCertificate[]
  statuses                EliteStatus[]
  /// per-field provenance: { field: { sourceType, reliability, observedAt, verification } }
  provenance              Json                 @default("{}")
  balanceSource           LoyaltyDataSource?
  balanceObservedAt       DateTime?
  refreshConfidence       Int                  @default(0)
  lastSuccessfulRefreshAt DateTime?
  nextRefreshAt           DateTime?
  refreshPriority         RefreshPriority      @default(NORMAL)
  observations            LoyaltyObservation[]
  syncRuns                LoyaltySyncRun[]

  @@index([userId])
  @@index([profileId])
}

/// Every balance change (and monthly snapshots): the history behind charts, and the redeemed / expired / transferred totals.
model LoyaltyEvent {
  id           String           @id @default(uuid())
  userId       String
  accountId    String
  kind         LoyaltyEventKind
  /// signed change in points (0 for a snapshot)
  points       Int              @default(0)
  balanceAfter Int
  occurredAt   DateTime         @default(now())
  note         String?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([userId])
}

/// Free night certificates, companion certificates and upgrade certificates.
model LoyaltyCertificate {
  id                  String              @id @default(uuid())
  userId              String
  profileId           String
  programId           String?
  accountId           String?
  category            CertificateCategory
  /// e.g. GLOBAL, REGIONAL, SYSTEMWIDE for upgrades
  subtype             String?
  name                String
  number              String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  quantity            Int                 @default(1)
  /// free-night award point cap
  pointCap            Int?
  restrictions        String?
  /// eligible hotels (brands/properties) or routes
  eligible            String[]            @default([])
  blackout            String?
  fareClasses         String?
  transferable        Boolean             @default(false)
  status              CertificateStatus   @default(AVAILABLE)
  potentialValueCents Int                 @default(0)
  usedAt              DateTime?
  usageNote           String?
  createdAt           DateTime            @default(now())
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile             Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  program             LoyaltyProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  account             LoyaltyAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  source              LoyaltyDataSource   @default(MANUAL)
  reliability         Int                 @default(25)
  observedAt          DateTime?
  verification        LoyaltyVerification @default(UNVERIFIED)
  /// structured rules parsed from the restriction text
  conditions          Json?
  externalKey         String?

  @@index([userId, status])
  @@index([expiresAt])
}

/// Elite status for one qualification period; earlier rows are the qualification history.
model EliteStatus {
  id                 String              @id @default(uuid())
  userId             String
  profileId          String
  programId          String?
  accountId          String?
  programName        String
  kind               StatusKind          @default(AIRLINE)
  level              String
  periodStart        DateTime?
  expiresAt          DateTime?
  /// what qualifies: nights, segments, PQP, points, spend
  metric             String?
  progress           Int                 @default(0)
  required           Int                 @default(0)
  /// already earned and kept for the period (no further qualification needed)
  maintained         Boolean             @default(false)
  renewalRequirement String?
  benefits           String[]            @default([])
  /// estimated annual value of the status
  valueCents         Int                 @default(0)
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  program            LoyaltyProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  account            LoyaltyAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  source             LoyaltyDataSource   @default(MANUAL)
  reliability        Int                 @default(25)
  observedAt         DateTime?
  verification       LoyaltyVerification @default(UNVERIFIED)

  @@index([userId])
  @@index([profileId, programName])
}

/// CLEAR, TSA PreCheck, Global Entry, lounge access and similar memberships.
model Membership {
  id                 String              @id @default(uuid())
  userId             String
  profileId          String
  kind               MembershipKind
  name               String
  joinedAt           DateTime?
  renewalAt          DateTime?
  expiresAt          DateTime?
  /// encrypted; only the last digits are ever shown
  memberNumberEnc    String?
  memberLast4        String?             @db.VarChar(8)
  benefits           String[]            @default([])
  renewalCostCents   Int                 @default(0)
  renewalMethod      String?
  autoRenew          Boolean             @default(false)
  linkedWalletCardId String?
  annualValueCents   Int                 @default(0)
  notes              String?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source             LoyaltyDataSource   @default(MANUAL)
  reliability        Int                 @default(25)
  observedAt         DateTime?
  verification       LoyaltyVerification @default(UNVERIFIED)

  @@index([userId])
}

/// Observed transfer bonuses over time (history, averages, seasonal expectation).
model TransferBonusRecord {
  id           String         @id @default(uuid())
  currencyId   String
  programId    String
  bonusPercent Int
  startsAt     DateTime
  endsAt       DateTime?
  source       String
  createdAt    DateTime       @default(now())
  currency     RewardCurrency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  program      LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([currencyId, programId, startsAt])
  @@index([currencyId, programId])
}

/// A planned award trip and the latest evaluation.
model AwardTrip {
  id           String   @id @default(uuid())
  userId       String
  destination  String
  dateFrom     DateTime
  dateTo       DateTime
  cabin        String
  hotelPrefs   String[] @default([])
  airlinePrefs String[] @default([])
  pointsNeeded Int?
  result       Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── loyalty automation ─────────────

enum LoyaltyDataSource {
  OFFICIAL_API
  AGGREGATOR
  EMAIL
  STATEMENT
  EXTENSION
  AI_DETECTED
  MANUAL
}

enum LoyaltyVerification {
  UNVERIFIED
  CROSS_CONFIRMED
}

enum ObservationOutcome {
  ACCEPTED // applied
  CONFIRMED // agrees with the stored value
  KEPT // lower reliability or older; stored value stands
  CONFLICT // disagrees with a similarly reliable source; needs the member
  PENDING // stored value is stale; waits for the member
  REJECTED // the member declined it
}

enum RefreshPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum SyncStatus {
  OK
  PARTIAL
  FAILED
}

/// Every value any source reports, with where it came from and what was done with it (the audit trail).
model LoyaltyObservation {
  id           String             @id @default(uuid())
  userId       String
  accountId    String?
  /// ACCOUNT | CERTIFICATE | STATUS | MEMBERSHIP
  entity       String             @db.VarChar(12)
  entityId     String?
  field        String             @db.VarChar(40)
  value        Json
  sourceType   LoyaltyDataSource
  reliability  Int
  observedAt   DateTime
  /// parser rule, extractor or import that produced it
  method       String             @db.VarChar(80)
  /// hash of the message / statement / snapshot; no content is stored
  evidenceHash String             @db.VarChar(64)
  dedupeKey    String             @db.VarChar(200)
  outcome      ObservationOutcome
  reason       String
  /// value that was stored when this was observed (for conflicts)
  storedValue  Json?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      LoyaltyAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([userId, outcome])
}

/// One refresh cycle: what ran, how, and what changed.
model LoyaltySyncRun {
  id           String          @id @default(uuid())
  userId       String
  accountId    String?
  /// EMAIL | STATEMENT | EXTENSION | MANUAL | SCHEDULED
  method       String          @db.VarChar(16)
  /// EVENT | DAILY | WEEKLY | MANUAL | SCHEDULED
  trigger      String          @db.VarChar(16)
  status       SyncStatus
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  observations Int             @default(0)
  changes      Int             @default(0)
  error        String?
  detail       Json?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      LoyaltyAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([accountId, startedAt])
}

// ───────────────────────────── Merchant offer automation ─────────────────────────────

enum OfferConnectorKind {
  MOCK
  EXTENSION
  EMAIL
  MANUAL
  ISSUER_LOGIN
}

enum OfferMfaMethod {
  NONE
  SMS
  APP
  AUTHENTICATOR
  PASSKEY
}

enum OfferSyncHealth {
  HEALTHY
  DEGRADED
  NEEDS_MFA
  NEEDS_LOGIN
  ERROR
  LOCKED
  DISABLED
}

enum OfferSyncCadence {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

/// One issuer login (or other source) for one household member. Credentials are encrypted (AES-256-GCM), write-only through the API and never logged.
model OfferAccount {
  id               String              @id @default(uuid())
  userId           String
  profileId        String?
  issuerId         String
  holderLabel      String
  connectorKind    OfferConnectorKind  @default(MANUAL)
  /// encrypted JSON {username,password}; null for sources that need none
  credentialEnc    String?
  /// non-secret hint shown in the UI, e.g. "user ••••42"
  credentialRef    String?
  mfaMethod        OfferMfaMethod      @default(NONE)
  deviceTrustEnc   String?
  sessionEnc       String?
  sessionExpiresAt DateTime?
  lastLoginAt      DateTime?
  lastSyncAt       DateTime?
  syncHealth       OfferSyncHealth     @default(DISABLED)
  failedLogins     Int                 @default(0)
  lockedAt         DateTime?
  lastError        String?
  /// per-account opt-in to server-side login, with the time the member acknowledged the terms risk
  automationOptIn  Boolean             @default(false)
  optInAckAt       DateTime?
  cadence          OfferSyncCadence    @default(DAILY)
  /// local hour (0-23) of the scheduled run, default 2 AM
  syncHour         Int                 @default(2)
  timezone         String              @default("America/New_York")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          Profile?            @relation(fields: [profileId], references: [id], onDelete: SetNull)
  issuer           Issuer              @relation(fields: [issuerId], references: [id])
  cards            OfferAccountCard[]
  items            OfferSnapshotItem[]
  snapshots        OfferSnapshot[]
  runs             OfferSyncRun[]

  @@index([userId])
  @@index([issuerId])
}

/// The wallet cards an offer account covers. Offers stay tied to the actual card; enrollments are never merged.
model OfferAccountCard {
  id           String       @id @default(uuid())
  accountId    String
  walletCardId String
  account      OfferAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  walletCard   WalletCard   @relation(fields: [walletCardId], references: [id], onDelete: Cascade)

  @@unique([accountId, walletCardId])
}

model OfferSnapshot {
  id        String       @id @default(uuid())
  accountId String
  runId     String?
  source    OfferSource
  takenAt   DateTime     @default(now())
  /// hash of the normalised inventory; an identical hash is a no-op
  hash      String
  itemCount Int
  account   OfferAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, takenAt])
}

enum OfferItemStatus {
  AVAILABLE
  ENROLLED
  REDEEMED
  EXPIRED
  REMOVED
}

enum OfferDecisionState {
  NEW
  RECOMMENDED
  PENDING_REVIEW
  IGNORED
  APPROVED
  ENROLLED
  AUTO_ENROLLED
  FAILED
}

/// Current state of one offer on one card of one account. History lives in OfferEvent.
model OfferSnapshotItem {
  id             String              @id @default(uuid())
  userId         String
  accountId      String
  /// the wallet card the offer is on, or "" when the source does not say
  cardKey        String              @default("")
  walletCardId   String?
  externalId     String
  merchantText   String
  merchantId     String?
  title          String
  category       String?
  offerType      OfferType           @default(STATEMENT_CREDIT)
  valueCents     Int                 @default(0)
  percent        Decimal?            @db.Decimal(5, 2)
  points         Int?
  minSpendCents  Int?
  endsAt         DateTime?
  status         OfferItemStatus     @default(AVAILABLE)
  decision       OfferDecisionState  @default(NEW)
  score          Int?
  scoreDetail    Json?
  decisionReason String?
  ruleId         String?
  autoEnrolled   Boolean             @default(false)
  userOfferId    String?
  contentHash    String
  firstSeenAt    DateTime            @default(now())
  lastSeenAt     DateTime            @default(now())
  removedAt      DateTime?
  enrolledAt     DateTime?
  savedCents     Int                 @default(0)
  account        OfferAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attempts       EnrollmentAttempt[]

  @@unique([accountId, cardKey, externalId])
  @@index([userId, decision])
  @@index([userId, status])
  @@index([endsAt])
}

enum RuleKind {
  ALWAYS
  NEVER
}

enum RuleMatcher {
  MERCHANT
  CATEGORY
  MIN_VALUE
  OFFER_TYPE
  KEYWORD
  SPEND_HISTORY
}

model EnrollmentRule {
  id           String      @id @default(uuid())
  userId       String
  label        String
  kind         RuleKind
  matcher      RuleMatcher
  matcherValue String
  /// optional scope: only this account or this wallet card
  accountId    String?
  walletCardId String?
  priority     Int         @default(100)
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

enum EnrollmentMode {
  RECOMMEND
  BULK_APPROVAL
  AUTO
}

model EnrollmentPolicy {
  userId     String         @id
  mode       EnrollmentMode @default(RECOMMEND)
  /// {allOffers,categories[],minValueCents,preferredMerchants[],matchSpendHistory,minScore}
  autoFilter Json           @default("{}")
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EnrollResult {
  SUCCESS
  FAILURE
  ALREADY_ADDED
  SESSION_TIMEOUT
  MFA_FAILURE
  PARTIAL
}

model EnrollmentAttempt {
  id         String              @id @default(uuid())
  userId     String
  itemId     String
  accountId  String
  mode       EnrollmentMode
  /// USER | SYSTEM | AGENT
  actor      String              @db.VarChar(8)
  result     EnrollResult
  detail     Json                @default("{}")
  verifiedBy ActivationVerifier?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       OfferSnapshotItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([itemId])
}

enum OfferSyncTrigger {
  SCHEDULED
  MANUAL
  RETRY
  EXTENSION
}

enum OfferSyncStatus {
  QUEUED
  RUNNING
  NEEDS_MFA
  SUCCESS
  PARTIAL
  FAILED
}

model OfferSyncRun {
  id         String           @id @default(uuid())
  userId     String
  accountId  String?
  /// groups the runs of one household-wide "sync now"
  batchId    String?
  trigger    OfferSyncTrigger
  status     OfferSyncStatus  @default(QUEUED)
  attempt    Int              @default(1)
  found      Int              @default(0)
  added      Int              @default(0)
  updated    Int              @default(0)
  removed    Int              @default(0)
  expired    Int              @default(0)
  enrolled   Int              @default(0)
  errors     Int              @default(0)
  warnings   Int              @default(0)
  /// step shown in the UI, e.g. "Reading offers"
  progress   String?
  messages   Json             @default("[]")
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    OfferAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([batchId])
  @@index([status])
}

// ───────────────────────────── System settings (maintenance mode, backup bookkeeping) ─────────────────────────────

/// Small key/value settings that belong to the system, not to a member.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum SearchEntryKind {
  HISTORY
  SAVED
}

/// A question the member asked the universal search bar (HISTORY, counted by how often) or chose to keep (SAVED).
/// The text has card numbers and e-mail addresses removed before it is stored.
model SearchEntry {
  id         String          @id @default(uuid())
  userId     String
  query      String
  normalized String
  intent     String?
  kind       SearchEntryKind @default(HISTORY)
  /// a name the member gave a saved search
  name       String?
  uses       Int             @default(1)
  /// the first line of the last answer, shown in recents
  summary    String?
  /// merchants, cards, programs and destination named in the question, for favourites and recents
  entityRefs Json?
  lastUsedAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalized, kind])
  @@index([userId, kind, lastUsedAt])
}

/// What a search conversation remembers between questions ("it", "my spouse"). Short-lived; never exported.
model SearchSession {
  id        String   @id @default(uuid())
  userId    String
  slots     Json     @default("{}")
  /// the last few questions and the first line of each answer
  turns     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

/// A reminder the member set (from a search answer or by hand). When it falls due they get a PointWise notification.
model Reminder {
  id        String         @id @default(uuid())
  userId    String
  title     String
  dueAt     DateTime
  /// a path inside the app, never another site
  link      String?
  source    String         @default("MANUAL")
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([status, dueAt])
}

/// What was sent to a model by AI Mode, exactly as sent (already redacted), so the member can inspect it. Kept 90 days.
model AiDisclosure {
  id        String   @id @default(uuid())
  userId    String
  runId     String?
  /// the provider name and model that received it
  provider  String
  model     String
  /// the provider is local (Ollama or the offline mock)
  local     Boolean  @default(false)
  purpose   String
  payload   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum GoalKind {
  STATUS
  FIVE24
  TRIP
  CASHBACK
  FEES
  MILES
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  DONE
  DROPPED
}

/// Something the member is working toward (earn Hyatt Globalist, stay under 5/24, visit Korea). Progress is computed from their own data.
model Goal {
  id             String     @id @default(uuid())
  userId         String
  profileId      String?
  kind           GoalKind
  title          String
  /// what counts as reaching it, by kind (program and level, a count, points, dollars, a destination)
  target         Json       @default("{}")
  status         GoalStatus @default(ACTIVE)
  /// 0-100, only for CUSTOM goals
  manualProgress Int?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum MemoryKind {
  PREFERENCE
  DECISION
  RECOMMENDATION
}

/// What Copilot remembers about the member: preferences they set (airlines, hotels, destinations), decisions about plan items
/// (snoozed, dismissed, done) and what it has already recommended. Kept in PointWise only; never sent to a model.
model CopilotMemory {
  id        String     @id @default(uuid())
  userId    String
  kind      MemoryKind
  key       String
  value     Json       @default("{}")
  /// USER (set by the member) or COPILOT (learned from what they did)
  source    String     @default("USER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind])
}

enum BriefingKind {
  DAILY
  WEEKLY
  MONTHLY
  BOARD
}

/// An AI Mode review written for the member: built from their own data, one per kind and period, kept 90 days.
model CopilotBriefing {
  id        String       @id @default(uuid())
  userId    String
  kind      BriefingKind
  /// the day (daily), the Monday (weekly) or the month (monthly) it covers
  periodKey String
  content   Json
  /// a model's wording, when one was allowed to see the redacted summary
  narration Json?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([userId, createdAt])
}

enum LifeEventKind {
  FAMILY_VACATION
  COLLEGE_VISIT
  MISSION_TRIP
  INTERNATIONAL
  BUSINESS_TRAVEL
  MAJOR_PURCHASE
  MOVING
  HOME_PROJECT
  OTHER
}

enum LifeEventStatus {
  PLANNING
  BOOKED
  DONE
  CANCELLED
}

/// Something coming up in the member's life that their cards, points and offers can help with. The title and notes are the member's own
/// words and never go into a redacted view; the estimate is worked out from their own data.
model LifeEvent {
  id          String          @id @default(uuid())
  userId      String
  kind        LifeEventKind
  title       String
  destination String?
  startsOn    DateTime?
  endsOn      DateTime?
  travelers   Int             @default(1)
  budgetCents Int?
  status      LifeEventStatus @default(PLANNING)
  estimate    Json?
  estimatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum MemberVisibility {
  OWN
  HOUSEHOLD
}

/// One-time link that lets a household member create their own sign-in. Only the SHA-256 of the token is stored.
model MemberInvite {
  id        String    @id @default(uuid())
  profileId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum CashbackKind {
  CASHBACK
  POINTS
}

/// A cash-back or points shopping site (Rakuten, TopCashback, an airline portal, ...). One shared list for the server, kept by the administrator.
model CashbackSite {
  id            String       @id @default(uuid())
  /// the value PortalRate.portal holds
  code          String       @unique
  name          String
  kind          CashbackKind @default(CASHBACK)
  homeUrl       String
  /// where a store page lives, with {slug} (the merchant's short name) or {host} (its web address); used only to read public rates
  storeUrlTemplate String?
  /// what one point is worth, in cents (points sites only)
  pointCents    Decimal?     @db.Decimal(6, 3)
  notes         String?
  isActive      Boolean      @default(true)
  /// the administrator lets PointWise read this site's public store pages for rates
  autoRead      Boolean      @default(false)
  // status: a light check of the public home page, and how the last rate read went
  lastCheckedAt DateTime?
  reachable     Boolean?
  httpStatus    Int?
  lastError     String?
  lastOkAt      DateTime?
  failures      Int          @default(0)
  lastReadAt    DateTime?
  lastReadNote  String?
  /// automatic reads that failed in a row; reading stops by itself after a few
  readFailures  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      UserCashbackAccount[]
}

/// A cash-back site a household member has an account on. No credentials are ever stored.
model UserCashbackAccount {
  id        String       @id @default(uuid())
  userId    String
  profileId String
  siteId    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  site      CashbackSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([profileId, siteId])
  @@index([userId])
}

/// The best cash-back rate a comparison site (Cashback Monitor) shows for a store across ALL sites, read from the headline of its public page.
/// Used only as a cross-check that the rates on file have not gone stale; never as a rate to pay out.
model MerchantBenchmark {
  id          String   @id @default(uuid())
  merchantId  String   @unique
  source      String
  bestPercent Decimal  @db.Decimal(5, 2)
  url         String
  observedAt  DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}
